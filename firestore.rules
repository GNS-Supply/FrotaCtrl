rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuUsuario() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function souPerfil(p) { return logado() && meuUsuario().tipo == p; }
    function souGestao() { return souPerfil('gestao_frota'); }
    function souAdmin() { return souPerfil('administrador'); }
    function souFornecedor() { return souPerfil('fornecedor'); }
    function souManutencao() { return souPerfil('manutencao'); }
    function souAprovador() { return souPerfil('aprovador'); }
    function souSolicitante() { return souPerfil('solicitante'); }
    // Administrador é a conta master oculta (acesso irrestrito); Gestão de
    // Frota tem, além das próprias funções, todas as permissões de cadastro
    // (plantas, setores, parâmetros, usuários) que antes eram só do admin.
    function souGestaoOuAdmin() { return souGestao() || souAdmin(); }
    // Perfis que podem atuar sobre um chamado além do próprio solicitante
    function souAtorInterno() { return souGestao() || souAdmin() || souFornecedor() || souManutencao() || souAprovador(); }

    match /usuarios/{userId} {
      allow read: if logado();
      // próprio usuário sempre pode criar/editar seu doc; Gestão de Frota
      // (ou o admin master) pode cadastrar colaboradores/fornecedores e
      // editar outros usuários — exceto a conta administrador, que fica
      // protegida (não pode ser vista/alterada/bloqueada por ninguém além
      // de si mesma).
      allow create: if logado() && (request.auth.uid == userId || souGestaoOuAdmin());
      allow update: if logado() && (
        request.auth.uid == userId ||
        (souGestaoOuAdmin() && resource.data.tipo != 'administrador')
      );
      allow delete: if souGestaoOuAdmin() && resource.data.tipo != 'administrador';
    }

    match /plantas/{id} {
      allow read: if logado();
      allow write: if souGestaoOuAdmin();
    }
    match /setores/{id} {
      allow read: if logado();
      allow write: if souGestaoOuAdmin();
    }
    // Doc que registra se a conta master já foi criada (bootstrap da
    // plataforma). Precisa ser gravável por qualquer pessoa logada, pois no
    // primeiro cadastro de todos ainda não existe nenhum administrador.
    match /configuracoes/bootstrap {
      allow read: if logado();
      allow write: if logado();
    }
    match /configuracoes/parametros {
      allow read: if logado();
      allow write: if souGestaoOuAdmin();
    }
    match /contadores/{id} {
      allow read: if logado();
      allow write: if logado(); // incrementado via transação ao abrir chamado
    }

    match /equipamentos/{id} {
      allow read: if logado();
      allow create: if souGestaoOuAdmin();
      allow update: if souGestaoOuAdmin() || souFornecedor() || souSolicitante();
      allow delete: if souGestaoOuAdmin();
    }

    match /chamados/{id} {
      allow read: if logado();
      allow create: if souSolicitante() && request.resource.data.solicitanteId == request.auth.uid;
      // atores internos sempre podem atuar; o próprio solicitante também
      // pode editar o chamado que abriu enquanto ele ainda estiver
      // "registrado" (ninguém começou a tratar ainda) — cobre casos como
      // anexar mais fotos logo após criar o chamado.
      allow update: if souAtorInterno() || (
        souSolicitante() &&
        resource.data.solicitanteId == request.auth.uid &&
        resource.data.status == 'registrado'
      );
      allow delete: if false;
    }
  }
}
